{
  "expo": {
    "name": "Legal Connect",
    "slug": "legal-connect",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "legalconnect",
    "userInterfaceStyle": "dark",
    "entryPoint": "./src/index.native.tsx",
    "platforms": ["ios", "android", "web"],
    "primaryColor": "#C5A059",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/images/law-library-bg.png",
        "backgroundColor": "#030303"
      },
      "package": "com.legalconnect.app"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legalconnect.app"
    },
    "web": {
      "favicon": "./public/images/law-library-bg.png",
      "output": "static"
    },
    "splash": {
      "image": "./public/images/law-library-bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#030303"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      ["expo-font", { "fonts": [] }],
      "expo-splash-screen"
    ]
  }
}
