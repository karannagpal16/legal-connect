NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://127.0.0.1:3000
ALLOWED_ORIGINS=https://legal-connect.in,https://www.legal-connect.in
APP_URL=https://legal-connect.in
PUBLIC_APP_URL=https://legal-connect.in

# Required in production — dedicated random secret (>= 32 chars). Never reuse DATABASE_URL.
SESSION_SECRET=
# Optional alias for SESSION_SECRET
JWT_SECRET=
# Optional AES-256 field encryption key (64 hex chars preferred). Falls back to SESSION_SECRET.
DATA_ENCRYPTION_KEY=

# Phase 2 real-mode placeholders. Do not commit real values.
DATABASE_URL=
DB_URL=
# Optional Postgres TLS CA PEM. When set, SSL verify is enforced.
PGSSL_CA=
# Set to "false" only for local Postgres without TLS.
PGSSL=true
REDIS_URL=
SENDGRID_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_SECRET=
# Merchant UPI VPA for a scannable QR. Leave empty unless needed.
LEGAL_CONNECT_UPI_VPA=
LEGAL_CONNECT_UPI_NAME=Legal Connect
EMAIL_PROVIDER=
SENDGRID_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=
SUPPORT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOTIFY_WORKER_TOKEN=

# Destructive admin wipe — keep false in production unless intentionally running a reset.
ALLOW_OPERATIONAL_RESET=false
# Master operator login — OFF in production unless explicitly enabled + password set in env.
ALLOW_MASTER_TEST_LOGIN=false
MASTER_TEST_EMAIL=
MASTER_TEST_PASSWORD=
# Extra emails that get all paid features free (comma-separated). Empty in production unless intentional.
# Builtin family free-list is disabled in production (startup-guards refuse BUILTIN_MASTER_FREE=true).
MASTER_FREE_EMAILS=
# Demo/sample auth shortcuts — never enable in production.
ALLOW_DEMO_AUTH=false
BUILTIN_MASTER_FREE=false

# Admin capability roles (store on users.role):
# super_admin | verification_admin | operations_admin | content_reviewer | finance_admin | support_admin
# RNA is treated as an admin/ops alias — never as advocate.

# Google Play review access — enable only during Play review, then disable + rotate code.
# Production also requires PLAY_REVIEW_ALLOW_PRODUCTION=true (fail-closed otherwise).
PLAY_REVIEW_ENABLED=false
PLAY_REVIEW_ALLOW_PRODUCTION=false
PLAY_REVIEW_EMAIL=
PLAY_REVIEW_CODE=
PLAY_REVIEW_EXPIRES_AT=

# eCourts access must be based on permitted official access.
OFFICIAL_ECOURTS_BASE_URL=https://services.ecourts.gov.in
POLL_FREQ_MIN=360
