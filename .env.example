NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://127.0.0.1:3000
ALLOWED_ORIGINS=https://legal-connect.in,https://www.legal-connect.in,https://legal-connect-7ewz.onrender.com
APP_URL=https://legal-connect.in
PUBLIC_APP_URL=https://legal-connect.in

# Phase 2 real-mode placeholders. Do not commit real values.
DB_URL=
REDIS_URL=
SENDGRID_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_SECRET=
# Merchant UPI VPA for a scannable QR. Defaults to 7982871464@ptaxis when unset.
LEGAL_CONNECT_UPI_VPA=7982871464@ptaxis
LEGAL_CONNECT_UPI_NAME=Legal Connect
EMAIL_PROVIDER=
SENDGRID_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=
SUPPORT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOTIFY_WORKER_TOKEN=

# Destructive admin wipe — keep false in production unless intentionally running a reset.
ALLOW_OPERATIONAL_RESET=false
# Master card (karannagpal16@gmail.com) — multi-portal login + free entitlements. Default on.
# Set ALLOW_MASTER_TEST_LOGIN=false to disable. Optional override for the master password:
ALLOW_MASTER_TEST_LOGIN=true
MASTER_TEST_PASSWORD=

# Google Play review access — enable only during Play review, then disable + rotate code.
# Production also requires PLAY_REVIEW_ALLOW_PRODUCTION=true (fail-closed otherwise).
PLAY_REVIEW_ENABLED=false
PLAY_REVIEW_ALLOW_PRODUCTION=false
PLAY_REVIEW_EMAIL=
PLAY_REVIEW_CODE=
PLAY_REVIEW_EXPIRES_AT=

# eCourts access must be based on permitted official access.
OFFICIAL_ECOURTS_BASE_URL=https://services.ecourts.gov.in
POLL_FREQ_MIN=360
